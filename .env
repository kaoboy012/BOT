# Rename this file to .env in the bot folder.
# Fill credentials locally. Do not commit .env, *.session, data/*.db or logs/.

# Telegram account: API_HASH is required.
API_ID=31560637
API_HASH=
SESSION_NAME=session_babao_bot

# Alert bot: fill ALERT_BOT_TOKEN to enable bot notifications.
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=8279295717
TELEGRAM_ADMIN_ID=8279295717
SUBMIT_SUCCESS_CHAT_ID=8279295717

# Telegram connection (timeouts are in seconds).
TELEGRAM_AUTO_RECONNECT=true
TELEGRAM_CONNECTION_RETRIES=5
TELEGRAM_MAX_RECONNECT_ATTEMPTS=50
TELEGRAM_CONNECT_TIMEOUT=30.0
TELEGRAM_HEARTBEAT_TIMEOUT=8.0
TELEGRAM_CHANNEL_TIMEOUT=10.0
TELEGRAM_SYNC_DIALOGS=true
TELEGRAM_CATCH_UP=false
TELEGRAM_FILTER_AT_SOURCE=true

# Durable inbox: keep recovery after a restart; stale codes still expire at 120s.
TELEGRAM_INBOX_DB_PATH=data/telegram_inbox.db
TELEGRAM_INBOX_DRAIN_BATCH=250
TELEGRAM_INBOX_DRAIN_INTERVAL=0.05
TELEGRAM_INBOX_ENQUEUE_RETRIES=3
TELEGRAM_INBOX_LEASE_SECONDS=300
TELEGRAM_INBOX_RECOVERY_MODE=at_least_once
MAX_INBOX_ATTEMPTS=3
INBOX_RETRY_BASE_DELAY=2.0
INBOX_RETRY_MAX_DELAY=120.0
CODE_MAX_AGE_SECONDS=120

# Telegram polling (seconds). Receiver polls sequentially and adapts to FloodWait.
CHANNEL_POLL_INTERVAL=5.0
CHANNEL_POLL_REQUEST_TIMEOUT=5.0
CHANNEL_POLL_FETCH_TIMEOUT=8.0
CHANNEL_POLL_MAX_INTERVAL=10.0
CHANNEL_POLL_FLOOD_DECAY_AFTER=60
POLL_STALL_RECONNECT_SECONDS=45.0
POLL_RECONNECT_COOLDOWN_SECONDS=120.0

# Queues/workers: preserve the existing concurrency settings.
MESSAGE_WORKERS=3
MAX_CONCURRENT_PROCESSING=16
MESSAGE_QUEUE_MAXSIZE=2000
DOMAIN_QUEUE_MAXSIZE=500
OCR_MEDIA_WORKERS=2
OCR_MEDIA_QUEUE_MAXSIZE=32
MAX_CONCURRENT_OCR=2
MAX_CONCURRENT_MEDIA_DOWNLOADS=3
FAST_TELEGRAM_DOWNLOAD=true
ACCOUNTS_PER_CODE=3
MAX_RETRIES_PER_ACCOUNT=1

# XX88 result detection timeout is in MILLISECONDS: 8000 = 8 seconds.
XX88_RESULT_DETECTION_TIMEOUT=8000

# QQ88 is paused. Set true and restart to resume. O8 has been removed.
QQ88_ENABLED=false

# Use only the existing Edge/browser tabs.
AUTO_OPEN_MISSING_TABS=false
EDGE_CDP_HOST=127.0.0.1
EDGE_CDP_PORT=9222

# Warm/recover CDP before a new giftcode arrives.
CDP_PING_INTERVAL=5.0
EDGE_CDP_CONNECT_TIMEOUT_SECONDS=15.0
EDGE_CDP_RECONNECT_COOLDOWN_SECONDS=5.0

# Existing tabs: XX88/MM88=3, RR88/GG88=2, HI88=1
MAX_CONCURRENT_SUBMITS_PER_DOMAIN=3
TAB_POOL_SIZE=3
